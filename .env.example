# Endpoint del formulario de contacto.
# Sin esta variable el formulario cae a un mailto: prellenado y sigue funcionando.
#
# Formspree  -> https://formspree.io/f/xxxxxxxx
# Web3Forms  -> https://api.web3forms.com/submit   (requiere VITE_FORM_ACCESS_KEY)
# Basin      -> https://usebasin.com/f/xxxxxxxx
VITE_FORM_ENDPOINT=

# Solo para Web3Forms: la clave de acceso del formulario.
VITE_FORM_ACCESS_KEY=
